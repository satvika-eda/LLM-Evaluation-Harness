# LLM Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
HUGGINGFACE_API_KEY=hf_...

# Database (docker-compose composes DATABASE_URL from POSTGRES_* itself;
# DATABASE_URL here is for running the API/worker outside Docker)
POSTGRES_USER=llm_eval
POSTGRES_PASSWORD=llm_eval
POSTGRES_DB=llm_eval
DATABASE_URL=postgresql://llm_eval:llm_eval@localhost:5432/llm_eval

# Cache
REDIS_URL=redis://localhost:6379/0
# How long cached generations live (seconds). Default 7 days — long enough to
# survive a run split across days by a judge daily-quota limit. Keys are
# content-addressed, so a long TTL can never serve a wrong answer.
CACHE_TTL_SECONDS=604800

# Dashboard → API base URL
FASTAPI_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# ── LLM judge (RAGAS / DeepEval scorers) ─────────────────────────────────────
# Independent of the open-weight models being benchmarked (pick a *different*
# model than any being benchmarked, to avoid self-preference bias). Routed
# through the HF Inference Providers router — an OpenAI-compatible endpoint —
# so the judge is open-weight too and effectively free vs. OpenAI's per-token
# billing. RAGAS embeddings stay on OpenAI regardless (JUDGE_* doesn't affect
# them — see ragas_scorer.py).
#
# gemma-3-27b-it was verified (2026-08-15) to reliably emit clean JSON for
# both RAGAS's Faithfulness decomposition prompt and DeepEval's Hallucination/
# GEval prompts. meta-llama/Llama-3.3-70B-Instruct was tried first and
# rejected — it rambles instead of emitting JSON on the RAGAS prompt, which
# silently drops the faithfulness score as an unparseable NaN.
LLM_JUDGE_MODEL=google/gemma-3-27b-it
JUDGE_BASE_URL=https://router.huggingface.co/v1
JUDGE_API_KEY=${HUGGINGFACE_API_KEY}
# To fall back to an OpenAI judge instead, comment the two lines above and
# uncomment: LLM_JUDGE_MODEL=gpt-4o-mini
# Max concurrent judge LLM calls per scorer — caps RAGAS/DeepEval fan-out so
# runs stay under the OpenAI tokens-per-minute ceiling. 2 is safe for tier 1.
JUDGE_MAX_CONCURRENCY=2
# Responses scored per chunk (commit checkpoint + memory bound). 10 keeps the
# BERTScore working set and judge bursts small on low-RAM hosts.
SCORING_CHUNK_SIZE=10

# ── BERTScore embedding model ────────────────────────────────────────────────
# roberta-large (~1.4 GB RAM) fits an 8 GB host; the higher-quality default
# microsoft/deberta-xlarge-mnli needs ~3.5 GB. Scores are NOT comparable
# across embedding models — pick one per benchmark and keep it.
BERTSCORE_MODEL=roberta-large

# ── MLflow experiment tracking ────────────────────────────────────────────────
# Every completed eval run logs its params/metrics to MLflow (best-effort —
# a tracking failure never fails the run itself). sqlite:///mlflow.db is a
# local file, no server needed; point this at a real MLflow tracking server
# URL to share runs across machines. (MLflow's plain filesystem backend,
# file:./mlruns, is in maintenance mode as of MLflow 3.x and rejects new runs.)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=llm-eval-harness
# Browse runs with: mlflow ui --backend-store-uri sqlite:///mlflow.db --port 5001
